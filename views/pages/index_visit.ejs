<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Sema Collect data - Visit</title>
    <link rel="stylesheet" href="/toastify.css">
    <meta charset="UTF-8">
    <script src="/toastify.js"></script>
    <script defer src="/toggle-theme.js"></script>
</head>
<body class="dark:bg-white">
    <div class="flex justify-center items-center min-h-svh">
        <div class="py-10 md:px-20 px-4 lg:w-3/5 xl:w-2/5 md:mx-auto">
          <div class="flex justify-between items-center">
            <img src="/logo.svg" alt="logo event" class="dark:hidden block"> 
            <img src="/logo-white.svg" alt="logo event" class="dark:block hidden">
            <!-- <button id="theme-toggle" class="bg-transparent">
              <img src="/toggle-white.svg" alt="toggle white" class="block dark:hidden"/>
              <img src="/toggle-dark.svg" alt="toggle dark" class="hidden dark:block" />
            </button> -->
            <button id="theme-toggle1" class="dark:hidden text-gray-300 bg-[#2B2E31] p-2 flex items-center rounded-lg outline-none focus:outline-none "><span class="sr-only hidden">Light Mode</span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg></button>
            <button id="theme-toggle2" class="dark:block hidden dark:bg-[#E6E8EB] p-2 text-gray-500 rounded-lg outline-none focus:outline-none focus-visible:ring focus-visible:ring-gray-100 focus:ring-opacity-20"><span class="sr-only hidden">Dark Mode</span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="24" height="24" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"></path></svg></button>     
          </div>       
            <h1 class="pt-6 dark:text-[#2B2E31]">Fiche de visite clientele</h1> </br>
            <table width="100%" style="margin-top: 1rem;" >
                <tr align="left">
                  <td ><span class="dark:text-color dark:text-[#454546] ml-0">Commercial : <%= sale_representative_name %></span></td>
                  <!-- <td ><span class="dark:text-color dark:text-[#454546] ml-0">Nombre de visite du jour : <%= sale_representative_count %></span></td> -->
                </tr>
                <tr align="left">
                  <td ><span class="dark:text-color dark:text-[#454546] ml-0">Date du jour : <%= sale_representative_date %></span></td>
                </tr>
                <tr align="left">
                  <td ><span class="dark:text-color dark:text-[#454546] ml-0">Nombre de visite du jour : <%= sale_representative_count %></span></td>
                </tr>
              </table>
            
            <form action="#" method="post" class="mt-4" id="form-submit">
                <input type="text" name="sale_representative_code" id="sale_representative_code" value="<%= sale_representative_code %>" hidden>
                <input type="text" name="sale_representative_id" id="sale_representative_id" value="<%= sale_representative_id %>" hidden>

                <input type="text" name="zone" class="w-full dark:bg-[#E6E8EB] dark:placeholder:text-[#2B2E31] dark:text-[#2B2E31] py-3 md:py-3 px-4 rounded-lg input-bg-color" placeholder="Zone du client">

                <input type="text" name="customer_name" class="w-full dark:bg-[#E6E8EB] dark:placeholder:text-[#2B2E31] dark:text-[#2B2E31] py-3 md:py-3 px-4 rounded-lg input-bg-color" placeholder="Nom du client *" required>

                <input type="text" name="business_name" class="w-full dark:bg-[#E6E8EB] dark:placeholder:text-[#2B2E31] dark:text-[#2B2E31] py-3 md:py-3 px-4 rounded-lg input-bg-color" placeholder="Nom du business *" required>
                
                <input type="tel" name="contact" id="phone" class="w-full dark:bg-[#E6E8EB] dark:placeholder:text-[#2B2E31] dark:text-[#2B2E31] py-3 md:py-3 px-4 rounded-lg input-bg-color" placeholder="Numéro de téléphone du contact (WhatsApp) *"
                pattern="^(\237|00237)?[26]\d{8}$" required>
                <small class="text-red-300 dark:text-red-500 hidden" id="phone-error">Entrez un numéro valide (avec ou sans indicatif : +237 ou 00237).</small>

                <input type="text" name="address" class="w-full dark:bg-[#E6E8EB] dark:placeholder:text-[#2B2E31] dark:text-[#2B2E31] py-3 md:py-3 px-4 rounded-lg input-bg-color" placeholder="Adresse *" required>
                
                <div class="relative flex w-full items-center">
                  <select name="category" id="category" class="custom-select w-full py-4 md:py-3 px-4 rounded-lg input-bg-color dark:bg-[#E6E8EB] dark:text-[#2B2E31] appearance-none">
                   <option disabled value="" selected hidden>Choisir la categorie *</option>
                   <option value="A">A</option>
                   <option value="B">B</option>
                   <option value="C">C</option>
                   <option value="D">D</option>
                  </select>
 
                   <!-- Flèche personnalisée -->
                   <div class="arrow-icon pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 dark:text-gray-800 text-gray-100">
                     <svg class="w-5 h-5 down-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                     </svg>
                     <svg class="w-5 h-5 up-arrow hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                     </svg>
                   </div>
                 </div>

                <div class="relative flex w-full items-center">
                  <select name="type_of_business" id="type_of_business" class="custom-select w-full py-4 md:py-3 px-4 rounded-lg input-bg-color dark:bg-[#E6E8EB] dark:text-[#2B2E31] appearance-none">
                    <option disabled value="" selected hidden>Choisir le type de business *</option>
                    <option value="bar">Bar</option>
                    <option value="agence de voyage">Agence de voyage</option>
                    <option value="snack">Snack</option>
                    <option value="restaurant">Restaurant</option>
                    <option value="hotel">Hôtel</option>
                    <option value="boutique">Boutique</option>
                    <option value="salon de beauté">Salon de beauté</option>
                    <option value="autre">Autre</option>
                  </select>
 
                   <!-- Flèche personnalisée -->
                   <div class="arrow-icon pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 dark:text-gray-800 text-gray-100">
                     <svg class="w-5 h-5 down-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                     </svg>
                     <svg class="w-5 h-5 up-arrow hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                     </svg>
                   </div>
                 </div>

                <div class="relative flex w-full items-center">
                  <select name="visit_objective" id="visit_objective" class="custom-select w-full py-4 md:py-3 px-4 rounded-lg input-bg-color dark:bg-[#E6E8EB] dark:text-[#2B2E31] appearance-none">
                   <option disabled value="" selected hidden>Choisir l'objectif de visite *</option>
                   <option value="contact du proprietaire">Contact du propriétaire</option>
                   <option value="vente de Sema">Vente de Sema</option>
                   <option value="evaluation du CA">Evaluation du CA</option>
                   <option value="prospection">Prospection</option>
                   <option value="evaluation du CA">Evaluation du CA</option>
                   <option value="ventes">Ventes</option>
                   <option value="mise en place mecanisme promotionnel">Mise en place mécanisme promotionnel</option>
                   <option value="autre">Autres</option>
                  </select>
 
                   <!-- Flèche personnalisée -->
                   <div class="arrow-icon pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 dark:text-gray-800 text-gray-100">
                     <svg class="w-5 h-5 down-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                     </svg>
                     <svg class="w-5 h-5 up-arrow hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                     </svg>
                   </div>
                 </div>

                <textarea name="achievement" id="achievement" rows="5" class="w-full dark:bg-[#E6E8EB] dark:placeholder:text-[#2B2E31] dark:text-[#2B2E31] py-3 md:py-3 px-4 rounded-lg  input-bg-color" placeholder="Réalisation *" required></textarea>

                <textarea name="comment" id="comment" rows="5" class="w-full dark:bg-[#E6E8EB] dark:placeholder:text-[#2B2E31] dark:text-[#2B2E31] py-3 md:py-3 px-4 rounded-lg input-bg-color" placeholder="Commentaire *" required></textarea>

                <textarea name="visit_carried_out" id="visit_carried_out" rows="5" class="w-full dark:bg-[#E6E8EB] dark:placeholder:text-[#2B2E31] dark:text-[#2B2E31] py-3 md:py-3 px-4 rounded-lg mb-2 input-bg-color" placeholder="Visite éffectuée ? prochaine action ! *" required></textarea>

                  <label class="relative flex justify-start items-center group py-2 text-xl mb-4" id="switch-localisation">
                    <input type="checkbox" class="absolute left-1/2 -translate-x-1/2 w-full h-full peer appearance-none rounded-md" id="localisation" required/>
                    <span class="w-16 h-10 flex items-center flex-shrink-0 ml-0 p-1 bg-white dark:bg-gray-300 rounded-full duration-300 ease-in-out peer-checked:bg-blue-400 after:w-8 after:h-8 after:bg-[#333652] after:rounded-full after:shadow-md after:duration-300 peer-checked:after:translate-x-6 group-hover:after:translate-x-1"></span>
                    <span class="ml-2 dark:text-[#2B2E31]">Récupérer ma localisation *</span>
                  </label>
                <button type="submit" class="w-full py-4 md:py-3.5 rounded-full" id="send-form">Envoyer</button>
            </form>
        </div>
    </div>
    <script src="/scripts_visit.js"></script>
</body>
</html>
