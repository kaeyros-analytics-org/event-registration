<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Sema Form Representative Create</title>
    <link rel="stylesheet" href="/toastify.css">
    <meta charset="UTF-8">
    <script src="/toastify.js"></script>
    <script defer src="/toggle-theme.js"></script>
</head>
<body class="dark:bg-white">
    <div class="flex justify-center items-center min-h-svh">
        <div class="py-10 md:px-20 px-4 lg:w-3/5 xl:w-2/5 md:mx-auto">
            <div class="flex justify-between items-center">
                <img src="/logo.svg" alt="logo event" class="dark:hidden block"> 
                <img src="/logo-white.svg" alt="logo event" class="dark:block hidden">

                <button id="theme-toggle1" class="dark:hidden text-gray-300 bg-[#2B2E31] p-2 flex items-center rounded-lg outline-none focus:outline-none "><span class="sr-only hidden">Light Mode</span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg></button>
                <button id="theme-toggle2" class="dark:block hidden dark:bg-[#E6E8EB] p-2 text-gray-500 rounded-lg outline-none focus:outline-none focus-visible:ring focus-visible:ring-gray-100 focus:ring-opacity-20"><span class="sr-only hidden">Dark Mode</span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="24" height="24" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"></path></svg></button>     
            </div> 
            <h1 class="pt-6 dark:text-[#2B2E31]">Enregistrement des informations du commercial pour la collecte des donnees</h1> </br>
            
            <form action="#" method="post" class="mt-6" id="form-submit">
                
                 <input type="text" name="name" class="w-full py-3 md:py-3 px-4 rounded-lg input-bg-color dark:bg-[#E6E8EB] dark:placeholder:text-[#2B2E31] dark:text-[#2B2E31]" placeholder="Nom du commercial *" required>
                <input type="text" id="link_form_data" style="display: none;" class="w-full py-3 md:py-3 px-4 rounded-lg input-bg-color dark:bg-[#E6E8EB] dark:placeholder:text-[#2B2E31] dark:text-[#2B2E31]" placeholder="Lien du commercial *">               
                <button type="submit" class="w-full py-4 md:py-4.5 rounded-full mt-4" id="send-form">Envoyer</button>
            </form>

        </div>
    </div>
    <script src="/scripts_representative.js"></script>
</body>
</html>
